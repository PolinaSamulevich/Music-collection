# Шаблон настроек. Скопируйте в файл .env и подставьте свои значения:
#   copy .env.example .env
# Файл .env в git не попадает (см. .gitignore) - там лежат пароли.

# Пароль пользователя sa в SQL Server.
# Требования SQL Server: минимум 8 символов, заглавные + строчные буквы + цифры.
SA_PASSWORD=ChangeMe_Str0ng!Pass

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
